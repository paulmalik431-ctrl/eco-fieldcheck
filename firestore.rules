rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in devices (anonymous auth) file claims; afterwards only the
    // audit and reviewer fields can change, and claims can't be deleted.
    match /claims/{claimId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.thumb is string
        && request.resource.data.thumb.size() < 400000;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['audit', 'review', 'reviewedAt', 'reviewerUid']);
      allow delete: if false;
    }
  }
}
